DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,supplychainx.example.com

DATABASE_URL=postgresql://supplychainx:supplychainx@localhost:5432/supplychainx
DB_ENGINE=django.db.backends.postgresql
DB_NAME=supplychainx
DB_USER=supplychainx
DB_PASSWORD=supplychainx
DB_HOST=localhost
DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

OSV_QUERY_URL=https://api.osv.dev/v1/querybatch
OSV_VULN_URL=https://api.osv.dev/v1/vulns/{vuln_id}
NVD_CVE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
ENABLE_NVD_ENRICHMENT=True
SCAN_HTTP_TIMEOUT=15

ENABLE_PIP_AUDIT=False
PIP_AUDIT_PATH=pip-audit
ENABLE_GITLEAKS=False
GITLEAKS_PATH=gitleaks

AI_PROVIDER=rule_engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SCAN_MAX_ZIP_BYTES=104857600
SCAN_MAX_UNCOMPRESSED_BYTES=262144000
SCAN_MAX_FILES=5000
SCAN_MAX_FILE_BYTES=52428800
SCAN_COMPRESSION_RATIO_LIMIT=200
SCAN_TIMEOUT_SECONDS=300

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
API_RATE_LIMIT=1000/hour
LOG_LEVEL=INFO
